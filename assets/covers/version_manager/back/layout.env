# Measured off art/back.jpg (version_manager, plate 1, home computer,
# nothing lettered on it), as fractions of its width (728px): no frame
# on the plate, the flask glyph — circle, neck, square label — ghosted
# between 0.44 and 0.84 of the width (centre at 0.45 of the height, 0.27
# across), the black band from 1.275 (0.906 of the height) — 0.13 tall,
# short like ash's, so the install lozenge sits beside the name in one
# row. The screenshots take the top of the face at their own 600:520;
# the strip is the pattern's defaults from NAME_Y. The frame rule is the
# home computer's: a heavy black rule with a thin line of the front's
# cream inside; the accent is that cream, the front's ground, since its
# enamel blue does not read on the violet.
FRAMES="0.075,0.07,0.40,0.347 0.525,0.07,0.40,0.347"
FRAME_RULE="#000000,6,#F0E9CC,2"
CAPTION_Y=0.44
HEAD_Y=0.51
PANEL=""
BLURB_Y=0.585
FEAT_Y=0.805
QUOTE_Y=0.975
F_QUOTE=URW-Bookman-Light-Italic
REQ_Y=1.105
NAME_Y=1.30
INSTALL_ROW=beside
# Bookman is wide and the command is long: the name a step smaller and
# tracked tighter, the command too, or the row runs 0.97 of the width.
NAME_POINT=0.019
NAME_KERN=0.001
INSTALL_POINT=0.014
ERA=home
ACCENT="#F0E9CC"
