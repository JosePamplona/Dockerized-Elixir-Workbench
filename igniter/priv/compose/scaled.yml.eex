# The workspace's scaled deployment, baked by the workbench:
#
#   docker-compose.scaled.yml  (scaled) - 'up --deploy scaled'
#
# The dev and prod files, docker-compose.yml and docker-compose.prod.yml,
# keep the pod pattern this one deliberately replaces with a bridge
# network. It is baked with as many replicas as --replicas asks for, and
# without the balancer when --no-balancer is given; 'up --deploy scaled'
# writes it again each time.

name: <%= @app_name %>

# Scaled deployment: the production replicas live on a regular bridge
# network — one IP each — all answering to the `app` network alias, so
# Docker's embedded DNS returns every address for that single name. That
# is exactly what DNSCluster queries through DNS_CLUSTER_QUERY, and how
# the replicas find each other.
#
# This file deliberately drops the pod pattern of docker-compose.yml.
# Replicas sharing a network namespace would share one IP and one port:
# only the first would bind the server, and every RELEASE_NODE would
# resolve to the same <name>@<ip>, a duplicate node name epmd rejects.
# The price of leaving the pod is that the database is no longer on
# localhost, hence the DATABASE_URL the app anchor overrides in projects
# that have one.
#
# The replicas form a BEAM cluster only with the clustering feature
# ('wb.sh add clustering'): its rel/env.sh.eex is what makes the release
# boot as a named distributed node. Without it they run isolated, which is
# a valid deployment on its own, and DNS_CLUSTER_QUERY is left out.

x-app: &app
  image: <%= @image %>
  build:
    context: .
    dockerfile: <%= @dockerfile %>
  env_file:
    - ./.env<%= if @clustering or @server do %>
  environment:
    # Overrides what .env declares: the pod's localhost database is gone,
    # and the name every replica answers to is the shared network alias.<%= if @clustering do %>
    DNS_CLUSTER_QUERY: app<% end %><%= if @server do %>
    DATABASE_URL: ecto://<%= @db_user %>:<%= @db_password %>@database/<%= @app_name %>_prod<% end %><% end %>
  networks:
    default:
      aliases:
        - app<%= if @server do %>
  depends_on:
    migrate:
      condition: service_completed_successfully<% end %>

services:<%= for {n, port} <- @replicas do %>
  app<%= n %>:
    <<: *app
    ports:
      - <%= port %>:<%= @internal_port %>
<% end %><%= if @balancer do %>
  # Single entry point in front of the replicas. They also publish one
  # host port each, so a specific node can still be addressed — which is
  # how cross-node behaviour is demonstrated.
  balancer:
    image: nginx:<%= @nginx_version %>
    ports:
      - <%= @balancer_port %>:80
    depends_on:<%= for {n, _port} <- @replicas do %>
      app<%= n %>:
        condition: service_started<% end %>
    configs:
      - source: balancer_conf
        target: /etc/nginx/conf.d/default.conf
<% end %><%= if @server do %>
  # One-shot migration (rel/overlays/bin/migrate, from phx.gen.release),
  # so the replicas do not race each other running it on boot. The<%= if @engine == "postgres" do %>
  # database itself is created by the postgres image from POSTGRES_DB.<% end %><%= if @engine == "mysql" do %>
  # database itself is created by the mysql image from MYSQL_DATABASE.<% end %><%= if @engine == "mssql" do %>
  # database itself is created by database_init below: the mssql image
  # has no variable that creates one, so a one-shot does, once the
  # server is healthy, and the migrator waits for it instead.<% end %>
  migrate:
    image: <%= @image %>
    build:
      context: .
      dockerfile: <%= @dockerfile %>
    command: /app/bin/migrate
    env_file:
      - ./.env
    environment:
      DATABASE_URL: ecto://<%= @db_user %>:<%= @db_password %>@database/<%= @app_name %>_prod
    depends_on:<%= if @engine == "mssql" do %>
      database_init:
        condition: service_completed_successfully

  database_init:
    image: mcr.microsoft.com/mssql/server:<%= @mssql_version %>
    command: ["/opt/mssql-tools18/bin/sqlcmd", "-C", "-S", "database", "-U", "sa", "-P", "some!Password", "-b", "-Q", "IF DB_ID('<%= @app_name %>_prod') IS NULL CREATE DATABASE [<%= @app_name %>_prod]"]
    depends_on:<% end %>
      database:
        condition: service_healthy

  # No `restart:`, as in the dev compose: the deployment is the unit,
  # across a reboot too.<%= if @engine == "postgres" do %>
  database:
    image: postgres:<%= @postgres_version %>
    environment:
      POSTGRES_PASSWORD: postgres
      POSTGRES_USER: postgres
      POSTGRES_DB: <%= @app_name %>_prod
    healthcheck:
      # -h forces TCP, as in the dev seed: the init's temporary server
      # answers the unix socket before the real one listens.
      test: pg_isready -q -h localhost -d <%= @app_name %>_prod -U postgres
      timeout: 45s
      interval: 10s
      retries: 10
      # Its init is quick, but it is an init: the same allowance, shorter.
      start_period: 30s<% end %><%= if @engine == "mysql" do %>
  database:
    image: mysql:<%= @mysql_version %>
    environment:
      # phx.new's own dev credentials for MySQL: root, no password.
      MYSQL_ALLOW_EMPTY_PASSWORD: "yes"
      MYSQL_DATABASE: <%= @app_name %>_prod
      # The image's init loads the time zone tables unless told not to:
      # seconds of the first start, for CONVERT_TZ(), which Ecto never
      # asks for — it works in UTC.
      MYSQL_INITDB_SKIP_TZINFO: "1"
    healthcheck:
      # 127.0.0.1 forces TCP, as in the dev compose: the init's temporary
      # server answers the unix socket before the real one listens.
      test: mysqladmin ping -h 127.0.0.1 --silent
      timeout: 45s
      interval: 10s
      retries: 10
      # The first start on a fresh volume initialises the data directory,
      # runs a temporary server and shuts it down before the real one
      # listens: a minute or more on a busy host, and a failure in this
      # period does not count — compose used to give up on it.
      start_period: 90s<% end %><%= if @engine == "mssql" do %>
  database:
    image: mcr.microsoft.com/mssql/server:<%= @mssql_version %>
    environment:
      # Microsoft's licence, accepted by running the image at all.
      ACCEPT_EULA: "Y"
      # phx.new's own dev credentials for MSSQL.
      MSSQL_SA_PASSWORD: some!Password
    # The image declares no volume of its own: an anonymous one, as the
    # dev compose has it.
    volumes:
      - /var/opt/mssql
    healthcheck:
      # mssql-tools18 is where the 2022 image ships sqlcmd; -C trusts
      # the server's own certificate, -b fails the command on an error.
      test: /opt/mssql-tools18/bin/sqlcmd -C -S localhost -U sa -P some!Password -Q "SELECT 1" -b
      timeout: 45s
      interval: 10s
      retries: 10
      # The first start on a fresh volume takes SQL Server minutes —
      # system databases, tempdb — and a failure in this period does not
      # count, or compose gave up on it before it answered (seen 2026-09-07).
      start_period: 180s<% end %>
<% end %><%= if @k6 do %>
  # A load tool, not a service of the deployment: k6 runs to completion,
  # so it sits under a profile 'up' never starts — './wb.sh k6 [SCRIPT]
  # --deploy scaled' runs it. On this network it aims at the balancer
  # when there is one, and at the `app` alias otherwise — the name every
  # replica answers to, so Docker's DNS spreads the users over them.
  k6:
    image: grafana/k6:<%= @k6_version %>
    profiles: [tools]
    environment:
      BASE_URL: <%= if @balancer, do: "http://balancer", else: "http://app:#{@internal_port}" %>
    volumes:
      - ./k6:/scripts:ro
<% end %><%= if @balancer do %>
configs:
  # $$ escapes compose's own interpolation: nginx must see a single $.
  balancer_conf:
    content: |
      # Connection header per request: "upgrade" for WebSockets (LiveView
      # and Channels need it), "close" for everything else.
      map $$http_upgrade $$connection_upgrade {
        default upgrade;
        ''      close;
      }

      upstream replicas {<%= for {n, _port} <- @replicas do %>
        server app<%= n %>:<%= @internal_port %>;<% end %>
      }

      server {
        listen 80;

        location / {
          proxy_pass http://replicas;
          proxy_http_version 1.1;
          proxy_set_header Host $$host;
          proxy_set_header X-Real-IP $$remote_addr;
          proxy_set_header X-Forwarded-For $$proxy_add_x_forwarded_for;
          proxy_set_header X-Forwarded-Proto $$scheme;
          proxy_set_header Upgrade $$http_upgrade;
          proxy_set_header Connection $$connection_upgrade;
          # Which replica answered: the address matches the Erlang node
          # name, so a repeated request shows the round-robin at work.
          add_header X-Served-By $$upstream_addr always;
        }
      }
<% end %>