<?xml version="1.0" encoding="UTF-8" ?>
<project name="PostgreSQL" database="PostgreSQL" id="PostgreSQL-52b" >
	<schema name="public" >
		<comment><![CDATA[standard public schema]]></comment>
		<udt name="message_role" udt_java_type="12" udt_precision="NONE" >
			<udt_script><![CDATA[CREATE TYPE ${name} AS ENUM ('system','user','assistant','function');]]></udt_script>
		</udt>
		<udt name="user_status" udt_java_type="12" udt_precision="NONE" >
			<udt_script><![CDATA[CREATE TYPE ${name} AS ENUM ('active','blocked');]]></udt_script>
		</udt>
		<table name="schema_migrations" row_count="0" spec="" >
			<column name="version" type="bigint" length="64" jt="-5" mandatory="y" />
			<column name="inserted_at" type="timestamp" length="0" jt="93" />
			<index name="schema_migrations_pkey" unique="PRIMARY_KEY" >
				<column name="version" />
			</index>
		</table>
		<table name="users" row_count="0" spec="" >
			<column name="id" type="uuid" jt="102" mandatory="y" />
			<column name="name" type="varchar" length="255" jt="12" mandatory="y" />
			<column name="status" type="user_status" jt="12" mandatory="y" />
			<column name="email" type="varchar" length="255" jt="12" mandatory="y" />
			<column name="email_verified" type="boolean" jt="16" mandatory="y" >
				<defo><![CDATA[false]]></defo>
			</column>
			<column name="phone_number" type="varchar" length="255" jt="12" />
			<column name="picture" type="varchar" length="255" jt="12" />
			<column name="token_sub" type="varchar" length="255" jt="12" mandatory="y" />
			<column name="inserted_at" type="timestamp" jt="93" mandatory="y" >
				<defo><![CDATA[now()]]></defo>
			</column>
			<column name="updated_at" type="timestamp" jt="93" mandatory="y" >
				<defo><![CDATA[now()]]></defo>
			</column>
			<index name="users_pkey" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<index name="users_token_sub_index" unique="UNIQUE_INDEX" spec="USING  btree" >
				<column name="token_sub" />
			</index>
			<index name="users_email_index" unique="UNIQUE_INDEX" spec="USING  btree" >
				<column name="email" />
			</index>
		</table>
	</schema>
	<layout name="Main Layout" id="Layout-c98" joined_routing="y" show_column_type="y" show_relation="columns" >
		<comment><![CDATA[%{project_name} - Entity-Relationship Diagram]]></comment>
		<entity schema="public" name="schema_migrations" color="3986C1" x="340" y="221" />
		<entity schema="public" name="users" color="B380B3" x="51" y="85" />
		<group name="Accounts" color="B380B3" >
			<entity schema="public" name="users" />
		</group>
	</layout>
	<layout name="~Layout with Sample Tools" id="Layout-2348" show_column_type="y" show_relation="columns" >
		<entity schema="public" name="schema_migrations" color="3986C1" x="374" y="51" />
		<entity schema="public" name="users" color="BED3F4" x="51" y="51" />
		<script name="SQL Editor" id="Editor-e9f" language="SQL" >
			<string><![CDATA[SELECT
	id, user_id, name, inserted_at, updated_at
FROM
	"public".conversations s;]]></string>
		</script>
	</layout>
</project>