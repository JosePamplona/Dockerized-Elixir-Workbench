# Elixir toolchain image: a bare development environment with no project
# code. The workbench builds it once per stack and Phoenix installer
# (workbench:ELIXIR-OTP-phxVERSION) and every workspace of that stack
# shares it; each project also keeps a baked copy of this
# file as its own Dockerfile.local, so a standalone clone can rebuild the
# same image without the workbench.
#
# The source is bind-mounted at /app/src by the workspace's
# docker-compose.yml — host edits hot-reload through Phoenix's code
# reloader, and code or dependency changes never require rebuilding
# this image. What is derived from the source (deps, _build) does NOT
# live in the mount: the compose declares a named volume over each of
# them, because compiling through a bind mount is the one load Docker
# Desktop's file sharing bears worst, and the host never needed the
# compiled code. The volume covers the path; nothing is written through.
#
# They are mounted where Mix looks for them on its own — /app/src/deps
# and /app/src/_build — and Mix is told nothing. It used to be told:
# two volumes outside the source and MIX_DEPS_PATH / MIX_BUILD_ROOT
# pointing at them. That worked for Mix and for nothing else. `phx.new`
# writes the conventional deps/ path into config.exs (NODE_PATH, for
# esbuild and tailwind) and into assets/vendor/heroicons.js, and asks
# Mix nothing; since phx_new 1.8 daisyUI is a git dependency resolved
# through that NODE_PATH, so a fresh project could not build its assets
# at all. The workbench patched those lines back. It no longer has to:
# whatever the generator writes next, if it is where Mix looks, it is
# where the volume is.
#
# We use Ubuntu/Debian instead of Alpine to avoid DNS resolution issues.
#
#   - https://hub.docker.com/r/hexpm/elixir/tags?name=debian
ARG ELIXIR="%{elixir_version}"
ARG    OTP="%{erlang_version}"
ARG DEBIAN="%{debian_version}"

ARG TOOLCHAIN_IMAGE="hexpm/elixir:${ELIXIR}-erlang-${OTP}-debian-${DEBIAN}"

FROM ${TOOLCHAIN_IMAGE} AS toolchain

# install build dependencies (inotify-tools powers Phoenix live reload)
RUN apt-get update -y && \
    apt-get install -y build-essential git inotify-tools && \
    apt-get clean && \
    rm -f /var/lib/apt/lists/*_*

# `mix phx.new` runs `git init` in the fresh project; without a default
# branch configured, git names it `master` and prints a hint block.
RUN git config --system init.defaultBranch main

# The image is always built locally, so it is born with the identity of
# the building user (pass --build-arg UID/GID if yours is not the
# typical single-user Linux 1000:1000): everything written into the
# mounted workspace keeps the right ownership.
ARG UID=1000
ARG GID=1000
RUN groupadd --gid ${GID} elixir && \
    useradd --uid ${UID} --gid ${GID} --create-home elixir

# The source mount point and the two directories under it that a volume
# covers: born owned by the user, so a named volume first mounted there
# takes that ownership with it. This is the whole reason they exist in
# the image — the bind mount hides them the moment it lands, and Docker
# still reads the image layer to seed an empty volume. A volume mounted
# on a path the image does not have comes up root-owned, and this
# container is not root. /app/igniter is the same arrangement for the
# workbench's own package, which runs here too ('wb.sh catalog').
WORKDIR /app
RUN mkdir -p /app/src/_build /app/src/deps /app/igniter/_build /app/igniter/deps && \
    chown -R elixir:elixir /app

USER elixir

# install hex + rebar and Phoenix (into the user's own home). The
# installer is stamped here at creation — hex's newest, or the one
# 'new --phx-new' named — and never moves after: it generates the
# project and, later, the delta every base cartridge takes, which
# refuses a phx.new other than the one that made the project. Same
# version, same generator, same delta. The value is the workspace's
# record of its own generator, and it is what makes this file enough
# on its own: a clone with no workbench builds the same image from it.
ARG PHX_NEW="%{phx_new_version}"
RUN mix local.hex --force && \
    mix local.rebar --force && \
    mix archive.install hex phx_new ${PHX_NEW} --force

# Self-initializing container: fetches dependencies, sets up the
# database (idempotent) and starts the server — all from the mounted
# source. The workspace's docker-compose.yml can override this with
# its `command:`. Mirrored in the compose seed's comment: keep in sync.
CMD ["sh", "-c", "cd /app/src && mix setup && mix phx.server"]
