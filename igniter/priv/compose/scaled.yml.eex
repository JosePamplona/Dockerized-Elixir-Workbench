# The workspace's scaled deployment, baked by the workbench:
#
#   docker-compose.scaled.yml  (scaled) - 'up --deploy scaled'
#
# The dev and prod files, docker-compose.yml and docker-compose.prod.yml,
# keep the pod pattern this one deliberately replaces with a bridge
# network. It is baked with as many replicas as --replicas asks for, and
# without the balancer when --no-balancer is given; 'up --deploy scaled'
# writes it again each time.

name: <%= @app_name %>

# Scaled deployment: the production replicas live on a regular bridge
# network — one IP each — all answering to the `app` network alias, so
# Docker's embedded DNS returns every address for that single name. That
# is exactly what DNSCluster queries through DNS_CLUSTER_QUERY, and how
# the replicas find each other.
#
# This file deliberately drops the pod pattern of docker-compose.yml.
# Replicas sharing a network namespace would share one IP and one port:
# only the first would bind the server, and every RELEASE_NODE would
# resolve to the same <name>@<ip>, a duplicate node name epmd rejects.
# The price of leaving the pod is that the database is no longer on
# localhost, hence the DATABASE_URL the app anchor overrides in projects
# that have one.
#
# The replicas form a BEAM cluster only with the clustering feature
# ('wb.sh add clustering'): its rel/env.sh.eex is what makes the release
# boot as a named distributed node. Without it they run isolated, which is
# a valid deployment on its own, and DNS_CLUSTER_QUERY is left out.

x-app: &app
  image: <%= @image %>
  build:
    context: .
    dockerfile: <%= @dockerfile %>
  env_file:
    - ./.env<%= if @clustering or @slots.app_environment do %>
  environment:
    # Overrides what .env declares: the pod's localhost database is gone,
    # and the name every replica answers to is the shared network alias.<%= if @clustering do %>
    DNS_CLUSTER_QUERY: app<% end %><%= if @slots.app_environment do %>
<%= @slots.app_environment %><% end %><% end %>
  networks:
    default:
      aliases:
        - app<%= if @slots.app_waits != [] do %>
  depends_on:<%= for {service, condition} <- @slots.app_waits do %>
    <%= service %>:
      condition: <%= condition %><% end %><% end %>

services:<%= for {n, port} <- @replicas do %>
  app<%= n %>:
    <<: *app
    ports:
      - <%= port %>:<%= @internal_port %>
<% end %><%= if @balancer do %>
  # Single entry point in front of the replicas. They also publish one
  # host port each, so a specific node can still be addressed — which is
  # how cross-node behaviour is demonstrated.
  balancer:
    image: nginx:<%= @version.("nginx", "alpine") %>
    ports:
      - <%= @balancer_port %>:80
    depends_on:<%= for {n, _port} <- @replicas do %>
      app<%= n %>:
        condition: service_started<% end %>
    configs:
      - source: balancer_conf
        target: /etc/nginx/conf.d/default.conf
<% end %><%= if @slots.services do %>
<%= @slots.services %>
<% end %><%= if @balancer or @slots.configs do %>
configs:<%= if @slots.configs do %>
<%= @slots.configs %><% end %><%= if @balancer do %>
  # $$ escapes compose's own interpolation: nginx must see a single $.
  balancer_conf:
    content: |
      # Connection header per request: "upgrade" for WebSockets (LiveView
      # and Channels need it), "close" for everything else.
      map $$http_upgrade $$connection_upgrade {
        default upgrade;
        ''      close;
      }

      upstream replicas {<%= for {n, _port} <- @replicas do %>
        server app<%= n %>:<%= @internal_port %>;<% end %>
      }

      server {
        listen 80;

        location / {
          proxy_pass http://replicas;
          proxy_http_version 1.1;
          proxy_set_header Host $$host;
          proxy_set_header X-Real-IP $$remote_addr;
          proxy_set_header X-Forwarded-For $$proxy_add_x_forwarded_for;
          proxy_set_header X-Forwarded-Proto $$scheme;
          proxy_set_header Upgrade $$http_upgrade;
          proxy_set_header Connection $$connection_upgrade;
          # Which replica answered: the address matches the Erlang node
          # name, so a repeated request shows the round-robin at work.
          add_header X-Served-By $$upstream_addr always;
        }
      }<% end %>
<% end %>