{
	"editor.tokenColorCustomizations": {
		"textMateRules": [
			//--- Elixir -------------------------------------------------------------
			{
				"scope": "source.elixir", // Codigo
				"settings": {
					"foreground": "#abb2bf"
				}
			},
			{ // LLaves
				"scope": [
					"punctuation.section.scope.elixir", // {}
					"punctuation.section.array.elixir", // []
					"punctuation.section.function.elixir", // ()
					"punctuation.section.list.begin.elixir", // Iniciador de lista (~w)
					"punctuation.section.list.end.elixir" // Terminador de lista (~w)
				],
				"settings": {
					"foreground": "#828997"
				}
			},
			{ //Comentarios
				"scope": [
					"punctuation.definition.comment.elixir", // Iniciador del comentario (#)
					"comment.line.number-sign.elixir", // Cuerpo del comentario
					"comment.unused.elixir", // Variable no usada
					"comment.documentation.heredoc.elixir" // Documentation
				],
				"settings": {
					"fontStyle": "italic",
					"foreground": "#5c6370"
				}
			},
			{
				"scope": [
					"constant.character.escape.elixir", // Caracteres de escape
					"constant.other.symbol.elixir" // Constante (:atom)
				],
				"settings": {
					"foreground": "#56b6c2"
				}
			},
			{
				"scope": [
					"punctuation.definition.constant.elixir", // Asignador de constante (:)
					"constant.language.elixir", // nil, true, false
					"constant.numeric.elixir" // Numeros
				],
				"settings": {
					"foreground": "#61afef"
				}
			},
			{
				"scope": "entity.name.function.elixir", // Nombre de función
				"settings": {
					"foreground": "#60acea"
				}
			},
			{
				"scope": [
					"keyword.control.module.elixir", // Defmodule
					"keyword.control.elixir", // Keywords: def, end...
					"variable.other.anonymous.elixir" // & del resolver
				],
				"settings": {
					"foreground": "#c678dd"
				}
			},
			{
				"scope": [
					"keyword.operator.other.elixir", // Pipes, ->...
					"keyword.operator.assignment.elixir", // =
					"keyword.operator.logical.elixir", // Operadores lógicos
					"keyword.operator.comparison.elixir", // Operadores de comparación
					"keyword.operator.arithmetic.elixir", // Operadores aritméticos
					"punctuation.separator.object.elixir", // comas
					"punctuation.separator.method.elixir", // Separador de modulos (.)
					"parameter.variable.function.elixir" // Argumentos de función
				],
				"settings": {
					"foreground": "#d19a66"
				}
			},
			{
				"scope": [
					"variable.other.constant.elixir", // Modulos
					"entity.name.type.module.elixir" // Definición de método (defmodule)
				],
				"settings": {
					"foreground": "#e5c07b"
				}
			},
			{ // String
				"scope": [
					"punctuation.definition.string.begin.elixir", // Iniciador de string (")
					"punctuation.definition.string.end.elixir", // Terminador de string (")
					"string.quoted.double.elixir", // Contenido de string ("string")
					"punctuation.definition.string.begin.elixir", // Iniciador de string (')
					"punctuation.definition.string.end.elixir", // Terminador de string (')
					"support.function.variable.quoted.single.elixir", // Contenido de string ('string')
					"string.quoted.double.interpolated.elixir", // Contenido de lista (~w(string))
					"string.quoted.double.literal.elixir" // Contenido fecha
				],
				"settings": {
					"foreground": "#98c379"
				}
			},
			{ // Embbebed
				"scope": [
					"punctuation.section.embedded.elixir", // Symbolo embbebeador
					"keyword.other.special-method.elixir", // alias, import, use
					"punctuation.definition.variable.elixir", // Iniciación de variable (@),
					"variable.other.readwrite.module.elixir",
					"variable.language.elixir"
				],
				"settings": {
					"foreground": "#e06c75"
				}
			},
			{ //Regex
				"scope": [
					"punctuation.section.regexp.begin.elixir", // Inicio de regex
					"punctuation.section.regexp.end.elixir", // Fin del regex
					"string.regexp.interpolated.elixir", // Contenido del regex
					"string.regexp.group.elixir", // Grupo regex ()
					"string.regexp.character-class.elixir", // Clase de caracteres regex [a-z]
					"string.regexp.arbitrary-repitition.elixir" // Repetición regex {2-4}
				],
				"settings": {
					"foreground": "#be5046"
				}
			}
		]
	}
}