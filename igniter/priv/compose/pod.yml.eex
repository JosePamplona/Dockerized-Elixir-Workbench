# The workspace's orchestration, baked by the workbench into two files:
#
#   docker-compose.yml       (dev)  - dev toolchain image, source mounted
#   docker-compose.prod.yml  (prod) - release image, no source volume and
#                                     no build identity args
#
# Both are the pod topology below with another image and two switches:
# the dev file has no one-shot 'migrate' service (the dev image migrates
# itself on boot) and the prod file makes the app wait for it; the prod
# file also carries no source mount and no build identity. The scaled
# deployment, docker-compose.scaled.yml, is another topology: it
# replaces the pod pattern with a bridge network. './wb.sh bake' writes
# this file again for the project as it is now.

name: <%= @app_name %>

services:
  # Pod pattern: this service's only job is to own the workspace's network
  # namespace and its published ports — literally the "pause" container
  # Kubernetes uses for the same job in its pods (~700 kB, sleeps forever).
  # Every other service joins it, so they all reach each other through
  # localhost — and the project keeps Phoenix's default database
  # configuration untouched.
  # No `restart:` on any service, here or in the scaled compose: a
  # deployment goes up and down whole, and that holds across a reboot
  # of the host too. With `unless-stopped` on the pod and the database
  # alone, a reboot brought those two back and left the app and pgadmin
  # down — half a deployment, which the status could only call "no
  # deployment is up and these are still here". Now a reboot leaves
  # everything exited, the status says down, and Up raises it whole.
  # What this gives up: a database that crashes is not restarted on its
  # own — the console's events feed says so, and Restart is a click.
  network:
    image: registry.k8s.io/pause:3.10
    ports:
      # Application port (host:container).
      - <%= @app_port %>:<%= @internal_port %><%= if @postgres do %>
      # pgAdmin port. The database is not published: it is only
      # reachable from inside this workspace.
      - <%= @pgadmin_port %>:<%= @pgadmin_internal_port %><% end %>

  app:
    image: <%= @image %>
    build:
      # Baked by the workbench: Dockerfile.local (dev toolchain) in
      # docker-compose.yml — whose app service also runs the workbench
      # one-off commands (add, mix), which need the toolchain —
      # and the production Dockerfile in docker-compose.prod.yml, baked
      # by 'up --env prod'. Do not point docker-compose.yml at the
      # production Dockerfile.
      dockerfile: <%= @dockerfile %><%= if @dev do %>
      # These arguments are only relevant for 'Dockerfile.local'.
      # Build identity for standalone builds (no workbench): the image is
      # born with the workspace creator's UID/GID, so files written into
      # the mounted source keep the right ownership. Edit if you build
      # this project on a host with a different user.
      args:
        UID: <%= @uid %>
        GID: <%= @gid %><% end %>
    # The image starts itself (CMD). Defaults per dockerfile —
    #   Dockerfile.local: sh -c 'cd /app/src && mix setup && exec mix phx.server'
    #   Dockerfile (prod): /app/bin/server
    # Uncomment to override:
    # command:
    # An init (docker's tini) as PID 1 above the command: it reaps what
    # the BEAM's ports leave behind — the esbuild and tailwind watchers
    # of a dev server — and forwards the signals of a stop.
    init: true
    network_mode: "service:network"
    env_file:
      - ./.env<%= if @dev do %>
    volumes:
      - .:/app/src
      # Compiled code and dependencies stay inside Docker, never in the
      # bind mount: a volume covers each of the two directories Mix
      # writes into, where Mix already looks for them — nothing is
      # written through to the host, and nothing has to be told where
      # they went. 'delete' drops them with the project.
      - build:/app/src/_build
      - deps:/app/src/deps<% end %><%= if @postgres do %>
    depends_on:
      <%= @app_waits_for %>:
        condition: <%= @app_waits_until %><% end %>
    healthcheck:
      # TCP-connect probe via bash (present in both the dev toolchain and
      # the prod runner image): no curl/wget needed.
      test: ["CMD", "bash", "-c", "</dev/tcp/localhost/<%= @internal_port %>"]
      interval: 10s
      timeout: 5s
      retries: 3
      # First compile & boot may take a while: not counted as failures.
      start_period: 120s
<%= if @migrate do %>
  # One-shot migration (rel/overlays/bin/migrate, from phx.gen.release):
  # the release phase every platform has under its own name — Heroku's
  # release phase, Fly's release_command, a Kubernetes Job. The same
  # image as the app, one command, run to completion before the app
  # starts: in docker-compose.prod.yml the app's depends_on waits on
  # this service instead of on the database (a migration that completed
  # implies a healthy one). The dev compose has no such service: the
  # dev image migrates itself on boot ('mix setup' in its CMD).
  migrate:
    image: <%= @image %>
    build:
      dockerfile: <%= @dockerfile %>
    command: /app/bin/migrate
    network_mode: "service:network"
    env_file:
      - ./.env
    depends_on:
      database:
        condition: service_healthy
<% end %><%= if @postgres do %>
  database:
    image: postgres:<%= @postgres_version %>
    network_mode: "service:network"
    environment:
      POSTGRES_PASSWORD: postgres
      POSTGRES_USER: postgres
      # Created when the data directory is initialised, and only then:
      # the production database the release deployments migrate into
      # ('bin/migrate' runs the migrations, it does not create the
      # database; 'mix ecto.create' does that for dev on its own). The
      # prod and scaled deployments share this container's volume with
      # dev, so the database has to be there from the first init.
      POSTGRES_DB: <%= @app_name %>_prod
    depends_on:
      - network
    healthcheck:
      # -h forces TCP: without it pg_isready asks the unix socket, which
      # the image's init already answers on its temporary server — so a
      # fresh volume said healthy before the real server listened, and
      # the migrator's first connections were refused.
      test: pg_isready -q -h localhost -d postgres -U postgres
      timeout: 45s
      interval: 10s
      retries: 10
<% end %><%= if @pgadmin do %>
  pgadmin:
    image: dpage/pgadmin4:<%= @pgadmin_version %>
    network_mode: "service:network"
    # `exec` on the last step, as the app's CMD: without it this shell
    # stayed PID 1 and every stop of pgadmin waited the 10 s of grace
    # and ended in SIGKILL (`die exit 137`, seen on the events feed).
    entrypoint: >
      /bin/sh -c "
      echo 'localhost:5432:*:postgres:postgres' > /var/lib/pgadmin/pgpass;
      chmod 600 /var/lib/pgadmin/pgpass;
      exec /entrypoint.sh
      "
    environment:
      PGADMIN_DEFAULT_EMAIL: pgadmin4@pgadmin.org
      PGADMIN_DEFAULT_PASSWORD: pass
      PGADMIN_LISTEN_PORT: <%= @pgadmin_internal_port %>
      PGADMIN_CONFIG_SERVER_MODE: 'False'
      PGADMIN_CONFIG_MASTER_PASSWORD_REQUIRED: 'False'
    depends_on:
      - database
    configs:
      - source: pgadmin_servers
        target: /pgadmin4/servers.json
<% end %><%= if @dev do %>
volumes:
  build:
  deps:
<% end %>
configs:
  pgadmin_servers:
    content: |
      {
        "Servers": {
          "1": {
            "Group": "Dockerized workbench",
            "Name": "<%= @app_name %>",
            "Host": "localhost",
            "Port": 5432,
            "MaintenanceDB": "postgres",
            "Username": "postgres",
            "PassFile": "/var/lib/pgadmin/pgpass",
            "SSLMode": "prefer"
          }
        }
      }
