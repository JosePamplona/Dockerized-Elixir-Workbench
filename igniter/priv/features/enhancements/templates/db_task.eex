defmodule Mix.Tasks.Db do
  use Mix.Task

  @version Mix.Project.config[:version]

  @source_path "assets/db_schema/"     # DbSchema soruce files.
  @light_path  "#{@source_path}light/" # DbSchema soruce light theme files path.
  @dark_path   "#{@source_path}dark/"  # DbSchema soruce dark theme files path.
  @svg         "MainLayout.svg"        # DbSchema *.svg image filename.
  @model       "database.md"           # DbSchema *.md documentation filename.

  @target_path  "./guides/" # Generated files target path.
  @light_target "model-light.svg" # Target light version model filename.
  @dark_target  "model-dark.svg"  # Target dark version model filename.
  
  @moduledoc """
    Adjusts and copies the necesary files from `#{@source_path}` into 
    `#{@target_path}` to enable ExDoc to integrate the database documentation 
    files.

    Compatible with files generated with [DbSchema](https://dbschema.com) 
    v9.5.3 - v9.6.5
    """

  @shortdoc "Prepares de DbSchema documentation to be included in ExDocs"
  @doc false
  def run(_) do
    Mix.shell().info("Formatting DbSchema files...")

    target_images_path = "#{@target_path}images/"

    File.mkdir_p!(target_images_path)
    File.cp!("#{@light_path}#{@svg}", "#{target_images_path}#{@light_target}")
    File.cp!("#{@dark_path}#{@svg}",  "#{target_images_path}#{@dark_target}")
    format_svg("#{target_images_path}#{@light_target}")
    format_svg("#{target_images_path}#{@dark_target}")

    content = File.read!("#{@light_path}#{@model}")
    formatted_content = format_content("#{content}")

    File.write!("#{@target_path}#{@model}", formatted_content)
    Mix.shell().info(
      "Success! the DbSchema files were generated:\n" <>
      "  #{@target_path}#{@model}\n" <>
      "  #{target_images_path}#{@light_target}\n" <>
      "  #{target_images_path}#{@dark_target}"
    )
  end

  # == Private =================================================================

  defp format_svg(filename) do    
    content = File.read!(filename)
    new_content =
      content
      |> String.replace(
        "System, 'Segoe UI', Dialog",
        "Lato, Arial, Helvetica, sans-serif"
      )
      |> String.replace("&quot;public&quot;&#46;", "")
    
    File.write!(filename, new_content)
  end

  defp format_content(content) do
    [
      "<!-- markdownlint-disable MD024 -->"
    ] ++ (
      content
      |> String.split("\n")
      |> Enum.with_index(&format/2)
      |> List.flatten()
      |> Enum.map(&String.trim/1)
    ) ++ [
      "<!-- tabs-close -->",
      ""
    ]
    |> Enum.reduce({[], nil}, fn line, {acc, last} ->
      if line == last, do: {acc, last}, else: {acc ++ [line], line}
    end)
    |> elem(0)
    |> Enum.join("\n")
  end

  defp format(_line, 0) do
    %{
      year: year,
      month: month,
      day: day,
      hour: hour,
      minute: minute,
      second: second,
      microsecond: {microsecond, 6}
    } = NaiveDateTime.utc_now()

    now =
      "`#{year}"
      |> Kernel.<>("-")
      |> Kernel.<>(String.pad_leading("#{month}", 2, "0"))
      |> Kernel.<>("-")
      |> Kernel.<>(String.pad_leading("#{day}", 2, "0"))
      |> Kernel.<>("` at `")
      |> Kernel.<>(String.pad_leading("#{hour}", 2, "0"))
      |> Kernel.<>(":")
      |> Kernel.<>(String.pad_leading("#{minute}", 2, "0"))
      |> Kernel.<>(":")
      |> Kernel.<>(String.pad_leading("#{second}", 2, "0"))
      |> Kernel.<>(".")
      |> Kernel.<>(String.pad_leading("#{microsecond}", 3, "0"))
      |> Kernel.<>("`")

    [
      "# Database",
      "",
      "Documentation integrated on #{now} for version: **#{@version}**."
    ]
  end

  defp format(line, _i) do
    line
    |> HtmlEntities.decode()
    |> format_table_row()
    # Matches are checked against lines that require additional formatting.
    |> case do
      "### Main Layout"  <> _rest -> [] # "## 📂 Entity-Relationship Diagram"
      "#####"     <> _rest = line -> [String.replace(line, "#####", "###"), ""]
      "Generated using"  <> _rest -> []
      "![img]"           <> _rest -> ["", "![img](./images/#{@light_target})"]
      "### Table public." <> rest ->
        [
          "<!-- tabs-close -->",
          "",
          "## #{rest}",
          "",
          "<!-- tabs-open -->",
          "",
          "### Schema",
          ""
        ]

      line -> line
    end
  end  

  defp format_table_row(line) do
    line =
      line
      |> String.replace("| \"public\".", "| ")
      |> String.replace("\\_", "_")
    
    line =
      ~r/^\|\s*([^|]+)\s*\|\s*([^|]+)\s*\|\s*([^|]+)\s*\|$/
      |> Regex.scan(line)
      |> case do
        [] -> line
        matches ->
          Enum.reduce(
            matches,
            line,
            fn 
              ([_, _, "Name ", _], acc) -> acc
              ([_, "---", "---", "---"], acc) -> acc
              ([_, first, second, third], _acc) ->
                format_fk_row(first, second, third)
            end
          )
      end
    
    line =
      ~r/^\|\s*([^|]+)\s*\|\s*([^|]+)\s*\|$/
      |> Regex.scan(line)
      |> case do
        [] -> line
        matches ->
          Enum.reduce(
            matches,
            line,
            fn 
              ([_, "Name ", _], acc) -> acc
              ([_, "---", "---"], acc) -> acc
              ([_, first, second], _acc) ->
                "| #{String.trim(first)} | `#{String.trim(second)}` |"
            end
          )
      end
    
    line
  end

  defp format_fk_row(first, second, third) do
    third =
      ~r/\(\s*\w+\s*\)\s+ref\s+(\[public\.(\w+)\]\(#\w+\))\s+\(\w+\)/
      |> Regex.scan(third)
      |> case do
        [] -> third
        matches ->
          Enum.reduce(
            matches,
            third,
            fn ([_, markdown_link, table], acc) ->
              String.replace(acc, markdown_link, table)
            end
          )
      end

    "| #{String.trim(first)} " <>
    "| #{String.trim(second)} " <>
    "| `#{String.trim(third)}` |"
  end
end
