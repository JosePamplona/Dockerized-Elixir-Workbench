defmodule <%= @app_module %>Web.OpenApi.Schemas.Message do
  @moduledoc false
  require OpenApiSpex

  alias <%= @app_module %>.Assistant.Message.RoleEnum
  alias OpenApiSpex.Schema

  OpenApiSpex.schema(%{
    description: "Represents an individual communication unit within a conversation.",
    type: :object,
    properties: %{
      role: %Schema{
        type: :string,
        format: :enum,
        enum: RoleEnum.__enums__,
        description: "Indicates the role or purpose of the message within the conversation."
      },
      content: %Schema{
        type: :string,
        description: "Indicates the content or message being communicated within the conversation."
      }
    },
    example: %{role: "assistant", content: "Hi! How can I help you?"}
  })

  def input(:standard), do: %Schema{
    type: :object,
    required: [:role, :content],
    properties: %{
      role: %Schema{
        type: :string,
        format: :enum,
        enum: RoleEnum.__enums__,
        description: """
          Provide the role or purpose of the message sender within the conversation.

          **system:** Indicates initial instructions or guidelines that set the behavior and context for the assistant throughout the conversation.<br>
          **user:** Represents the input or messages provided by the user, typically questions, commands, or prompts directed to the assistant.<br>
          **assistant:** Represents the responses generated by the assistant based on the user's input or system instructions.<br>
          **function:** Represents the output or result returned by a specific function call made during the conversation, often used to provide external data or execute actions.<br>
          """
      },
      content: %Schema{
        type: :string,
        description: "Provide the message being communicated within the conversation."
      }
    }
  }
end
