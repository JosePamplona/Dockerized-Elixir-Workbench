@moduledoc """
GraphQL schema root.

Add object types under `<%= @web_module %>.Graphql.Schemas` and their
resolvers under `<%= @web_module %>.Graphql.Resolvers`, then import and
expose them here.
"""

use Absinthe.Schema

query do
  @desc "Application version."
  field :version, :string do
    resolve(fn _parent, _args, _resolution ->
      {:ok, Application.spec(:<%= @app_name %>, :vsn) |> to_string()}
    end)
  end
end
