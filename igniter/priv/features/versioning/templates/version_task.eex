defmodule Mix.Tasks.Version do
  @shortdoc "Writes the version you chose into mix.exs, the changelog and the README badge"

  @moduledoc """
  #{@shortdoc}

      mix version 1.2.0

  Three files, each only where it carries a version:

    * `mix.exs`: the `version:` of the project. Required; the task fails
      when it cannot find one.
    * `CHANGELOG.md`: the `Unreleased` section is closed as this version,
      dated today, by writing the release title right under the commented
      template line the workbench's changelog keeps for it. Skipped, with
      a note, when there is no changelog or no template line.
    * `README.md`: the version badge, when the README has one. Skipped
      silently otherwise.

  Deciding the number is yours; this writes it.
  """

  use Mix.Task

  @mix_file "mix.exs"
  @changelog_file "CHANGELOG.md"
  @readme_file "README.md"

  @doc false
  def run([new_version]) do
    with :ok <- write_mix(new_version),
         changelog <- write_changelog(new_version),
         readme <- write_readme(new_version) do
      Mix.shell().info(
        Enum.join(
          ["Version #{new_version}:", "  #{@mix_file}"] ++
            List.wrap(changelog) ++ List.wrap(readme),
          "\n"
        )
      )
    else
      {:error, file} -> Mix.raise("#{file} carries no version this task can set.")
    end
  end

  def run(_), do: Mix.raise("Usage: mix version NEW_VERSION")

  # == mix.exs =================================================================

  defp write_mix(version) do
    content = File.read!(@mix_file)

    case Regex.run(~r/version: "([^"]*)"/, content) do
      [line, current] ->
        File.write!(@mix_file, String.replace(content, line, String.replace(line, current, version)))

      _ ->
        {:error, @mix_file}
    end
  end

  # == CHANGELOG.md ============================================================

  # The workbench's changelog keeps a commented title line under
  # `Unreleased` as the template for cutting a release; the release title
  # goes right under it, so what was unreleased becomes this version's.
  @template ~r/^<!-- ## v[\d.]+ - \([\d-]+\) -->$/m

  defp write_changelog(version) do
    with true <- File.exists?(@changelog_file),
         content = File.read!(@changelog_file),
         [line] <- Regex.run(@template, content) do
      title = "## v#{version} - (#{Date.utc_today()})"
      File.write!(@changelog_file, String.replace(content, line, "#{line}\n\n#{title}"))
      "  #{@changelog_file} (Unreleased closed as v#{version})"
    else
      false -> "  #{@changelog_file}: none, skipped"
      nil -> "  #{@changelog_file}: no release template line, skipped"
    end
  end

  # == README.md ===============================================================

  @badge ~r/!\[v([^\]]*)\]\((https:\/\/img\.shields\.io\/badge\/version-)([^-]*)(-[^)]*\.svg)\)/

  defp write_readme(version) do
    with true <- File.exists?(@readme_file),
         content = File.read!(@readme_file),
         [line, _, url, _, tail] <- Regex.run(@badge, content) do
      File.write!(@readme_file, String.replace(content, line, "![v#{version}](#{url}#{version}#{tail})"))
      "  #{@readme_file}"
    else
      _ -> []
    end
  end
end
