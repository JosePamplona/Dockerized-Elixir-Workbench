# Measured off art/back.jpg (health_probe, plate 3, manual from the hero,
# no lettering on it), as fractions of its width (728px): the embossed
# frame's top at 0.07, the colophon between 0.58 and 0.84, the darker
# band from 1.16. The screenshots take the top of the face. The strip is
# the pattern's defaults: NAME_Y sets where the name lozenge starts on
# the band, and the install lozenge, the legal line, the seal's size and
# the block's centring follow from it, ignoring the frame that runs
# through the band.
FRAMES="0.075,0.12,0.40,0.347 0.525,0.12,0.40,0.347"
FRAME_RULE="#2A1830,6,#D4B27E,2"
CAPTION_Y=0.485
HEAD_Y=0.545
PANEL=""
BLURB_Y=0.615
FEAT_Y=0.825
QUOTE_Y=0.945
F_QUOTE=Bitstream-Charter-Italic
REQ_Y=1.05
NAME_Y=1.185
ERA=editorial
ACCENT="#D4B27E"
