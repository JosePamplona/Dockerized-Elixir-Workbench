{
  "name": "Dockerized Elixir Workbench",
  "about": "The one source of the house's colours and type. Everything visual that is not a cover reads from here through assets/design/build.py: the console's stylesheet, the diagram skill's profile. Edit this file, run the build; never edit what it generates.",
  "palette": {
    "violet": {
      "value": "#4B275F",
      "from": "the printed board of the covers overlay (assets/covers/overlay.png): Elixir violet"
    },
    "violet-ink": {
      "value": "#F3ECF5",
      "from": "the lettering on that board"
    },
    "gold": {
      "value": "#D4B27E",
      "from": "the seal (assets/covers/seal.png) and the backs' accent"
    },
    "gold-deep": {
      "value": "#9A7A3E",
      "from": "the same gold, deep enough to read on light ground"
    }
  },
  "roles": {
    "ground": {
      "light": "#F2EDF3",
      "dark": "#160F1B",
      "use": "the page"
    },
    "surface": {
      "light": "#FBF8FC",
      "dark": "#22182A",
      "use": "panels, cards, node fills"
    },
    "surface-2": {
      "light": "#EBE3EE",
      "dark": "#2C2036",
      "use": "inset panels, chips"
    },
    "line": {
      "light": "#D6CBDA",
      "dark": "#3B2D46",
      "use": "hairlines, borders"
    },
    "ink": {
      "light": "#1D1424",
      "dark": "#EFE7F2",
      "use": "text, primary strokes"
    },
    "muted": {
      "light": "#6B5C76",
      "dark": "#A394AE",
      "use": "secondary text, default arrows"
    },
    "soft": {
      "light": "#8F819A",
      "dark": "#7E7189",
      "use": "sublabels, the quietest text"
    },
    "board": {
      "light": "{violet}",
      "dark": "{violet}",
      "use": "the band; the covers' board"
    },
    "board-ink": {
      "light": "{violet-ink}",
      "dark": "{violet-ink}",
      "use": "lettering on the band"
    },
    "board-warn": {
      "value": "{warn:dark}",
      "use": "a state on the band: waiting for your word"
    },
    "board-bad": {
      "value": "{bad:dark}",
      "use": "a state on the band: no connection"
    },
    "selection": {
      "light": "rgba(75,39,95,.22)",
      "dark": "rgba(243,236,245,.15)",
      "use": "selected text: a veil of the board over what is under it, never a block"
    },
    "accent": {
      "light": "{gold-deep}",
      "dark": "{gold}",
      "use": "the one focal colour: a button, a stamp, a focal node"
    },
    "accent-ink": {
      "light": "#FFFFFF",
      "dark": "#1D1424",
      "use": "text on accent"
    },
    "accent-soft": {
      "light": "rgba(154,122,62,.12)",
      "dark": "rgba(212,178,126,.14)",
      "use": "accent-tinted fills"
    },
    "link": {
      "light": "#3F6FA8",
      "dark": "#8DBBE8",
      "use": "HTTP and external edges in diagrams"
    },
    "good": {
      "light": "#2E8B57",
      "dark": "#7BC47F",
      "use": "healthy, done"
    },
    "warn": {
      "light": "#B7791F",
      "dark": "#E3B25C",
      "use": "starting, pending"
    },
    "bad": {
      "light": "#C0392B",
      "dark": "#E06C5F",
      "use": "exited, failed"
    },
    "shadow": {
      "light": "0 10px 24px rgba(75,39,95,.18), 0 2px 4px rgba(75,39,95,.12)",
      "dark": "0 14px 30px rgba(0,0,0,.45), 0 2px 4px rgba(0,0,0,.35)",
      "use": "a box on the shelf"
    },
    "shelf": {
      "light": "#7A5E3E",
      "dark": "#3A2A45",
      "use": "the plank"
    },
    "shelf-edge": {
      "light": "#5C4530",
      "dark": "#2A1D33",
      "use": "its edge"
    },
    "scroll": {
      "light": "#C9BDCE",
      "dark": "#52425F",
      "use": "the scrollbar thumb, on the house's grounds"
    },
    "term": {
      "light": "#FDFBFE",
      "dark": "#120B17",
      "use": "terminal ground: what runs and what is read as code. Dark on both grounds until 2026-09-07 (assets/design/fuente-claro.html): it follows the theme now, so a light page reads its code on paper"
    },
    "term-ink": {
      "light": "#2B2133",
      "dark": "#D9CFDF",
      "use": "terminal text"
    },
    "term-dim": {
      "light": "#8F819A",
      "dark": "#8B7C96",
      "use": "terminal timestamps, comments"
    },
    "term-line": {
      "light": "#D6CBDA",
      "dark": "#2B1F33",
      "use": "terminal border"
    },
    "term-scroll": {
      "light": "#C9BDCE",
      "dark": "#4A3A57",
      "use": "the scrollbar thumb on a terminal ground"
    },
    "term-tint": {
      "light": "rgba(29,20,36,.05)",
      "dark": "rgba(255,255,255,.05)",
      "use": "a wash on the terminal ground: a hovered line, a diff's gutter, a hunk's head"
    },
    "ansi-red": {
      "light": "#B5473A",
      "dark": "#F3A196",
      "use": "ANSI 1 and 9; an error's line, a missing key"
    },
    "ansi-green": {
      "light": "#2E8B57",
      "dark": "#9BD99A",
      "use": "ANSI 2 and 10; a line added, a value"
    },
    "ansi-yellow": {
      "light": "#B7791F",
      "dark": "#E3B25C",
      "use": "ANSI 3 and 11; a warning's line, a line updated"
    },
    "ansi-blue": {
      "light": "#3F6FA8",
      "dark": "#8FB8F0",
      "use": "ANSI 4 and 12"
    },
    "ansi-magenta": {
      "light": "#8E44AD",
      "dark": "#D3A6E8",
      "use": "ANSI 5 and 13"
    },
    "ansi-cyan": {
      "light": "#1F8A8A",
      "dark": "#8FDCD8",
      "use": "ANSI 6 and 14"
    },
    "svc-app": {
      "value": "#B58BD9",
      "use": "the app service, in logs"
    },
    "svc-database": {
      "value": "#6FA8DC",
      "use": "the database service"
    },
    "svc-pgadmin": {
      "value": "#5FBFA6",
      "use": "pgAdmin"
    },
    "svc-adminer": {
      "value": "#8FBF5F",
      "use": "Adminer — it was written into the console's copy of tokens.css by hand with the adminer cartridge, 2026-09-10, and the build took it out; here since 2026-09-12, where the build reads"
    },
    "svc-network": {
      "value": "#9A8FA3",
      "use": "the network (pause) container"
    },
    "svc-balancer": {
      "value": "#E0955A",
      "use": "the balancer, in the scaled deployment"
    },
    "svc-migrate": {
      "value": "#C9A0DC",
      "use": "the one-shot migration"
    },
    "addr-port": {
      "light": "{link:light}",
      "dark": "{link:dark}",
      "use": "the layer square on an address that is a service's port, read off docker compose ps (localhost:4001, database:5432)"
    },
    "addr-route": {
      "light": "#6E3E8C",
      "dark": "#BE9BDE",
      "use": "the layer square on an address the reader opens and the knock reads by HTTP — a route on the app's port (/dev/mailbox) or a service's web face (pgAdmin's /); near svc-app on purpose, not it — that one means the app's log lines"
    }
  },
  "type": {
    "display": {
      "family": "Barlow Condensed",
      "weights": [
        500,
        600,
        700
      ],
      "fallback": "\"Arial Narrow\", Impact, sans-serif",
      "use": "the band's lettering: labels, headings, names",
      "css": "cond"
    },
    "text": {
      "family": "Source Serif 4",
      "weights": [
        400,
        600
      ],
      "italic": true,
      "fallback": "Georgia, \"Times New Roman\", serif",
      "use": "prose, as on the backs of the boxes",
      "css": "serif"
    },
    "code": {
      "family": "IBM Plex Mono",
      "weights": [
        400,
        500
      ],
      "fallback": "ui-monospace, \"SF Mono\", Menlo, monospace",
      "use": "commands, logs, ports, anything technical",
      "css": "mono"
    }
  },
  "google-fonts": "https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=IBM+Plex+Mono:wght@400;500&display=swap"
}
