# Measured off art/back.jpg (test_doubles, plate 1, manual like the hero,
# nothing lettered on it), as fractions of its width (728px). The plate is
# a bulkhead interior, not a flat board, so the layout is measured against
# what is actually there: the ceiling at the top is the flattest field on
# the plate (stddev 6-10), which is where the frames go; the lit panel of
# gears runs 0.44-0.70 of the height (stddev 17-24) and the copy is set
# over it; the flasks and the CRTs are 0.84-0.90 (stddev 29-40); the dark
# foot from 0.94 (stddev 11-19) is the nearest thing to a band, thin, so
# the install lozenge sits beside the name in one row. Frame rule in the
# era's idiom: a bright chrome rule with a dark line inside. The accent is
# the wireframe figure's cyan, read off the hero.
FRAMES="0.075,0.06,0.40,0.186 0.525,0.06,0.40,0.186"
FRAME_RULE="#B9E6F3,5,#1A2238,2"
CAPTION_Y=0.275
HEAD_Y=0.35
PANEL=""
BLURB_Y=0.43
FEAT_Y=0.72
QUOTE_Y=1.005
REQ_Y=1.105
NAME_Y=1.295
# The band is thin and the command is long: the row comes in a step.
NAME_POINT=0.019
NAME_KERN=0.001
INSTALL_POINT=0.014
INSTALL_ROW=beside
ERA=cdrom
ACCENT="#B9E6F3"
