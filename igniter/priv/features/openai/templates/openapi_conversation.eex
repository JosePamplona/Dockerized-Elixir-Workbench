defmodule <%= @app_module %>Web.OpenApi.Schemas.Conversation do
  @moduledoc false
  require OpenApiSpex

  alias OpenApiSpex.Schema

  OpenApiSpex.schema(%{
    description: "Represents a complete dialogue context, tracking the sequence of messages.",
    type: :object,
    properties: %{
      id: %Schema{
        type: :string,
        format: :uuid,
        description: "A unique identifier for the resource, represented as a UUID (Universally Unique Identifier). This ID is automatically generated by the system."
      },
      name: %Schema{
        type: :string,
        description: "Conversation given name. The conversation name is unique for each user."
      },
      messages: %Schema{
        type: :array,
        items: <%= @app_module %>Web.OpenApi.Schemas.Message
      },
      inserted_at: %Schema{
        type: :string,
        format: :datetime,
        description: "The date and time when the resource was created, in ISO 8601 format."
      },
      updated_at: %Schema{
        type: :string,
        format: :datetime,
        description: "The date and time when the resource was created, in ISO 8601 format."
      }
    },
    required: [],
    example: %{
      id: "00000000-0000-4000-8000-000000000000",
      name: "Test 1",
      messages: [
        %{role: "system", content: "You are a useful assistant who preferably responds in Spanish."},
        %{role: "user", content: "I need something ..."}
      ],
      inserted_at: "2025-01-21 22:59:49.278646",
      updated_at: "2025-01-21 22:59:49.278646"
    }
  })
end
