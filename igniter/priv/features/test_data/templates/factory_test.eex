@moduledoc false

use <%= @case %>, async: true

import <%= @factory %>, only: [build: 1, insert: 1]

# Every `*_factory/0` of the factory module, found by name: a factory
# added there is checked here without a line of this file changing.
factories =
  for {name, 0} <- <%= @factory %>.__info__(:functions),
      String.ends_with?(Atom.to_string(name), "_factory"),
      do: name |> Atom.to_string() |> String.replace_suffix("_factory", "") |> String.to_atom()

for factory <- factories do
  @factory factory
<%= if @data_case do %>
  # Inserted inside the sandbox: a NOT NULL, a foreign key or a unique
  # index the factory breaks fails here, by the factory's name. What is
  # not a table — a map, an embedded schema — is built, not inserted.
  test "#{factory} inserts" do
    record = build(@factory)

    if table?(record) do
      assert insert(@factory).__meta__.state == :loaded
    else
      assert record
    end
  end
<% else %>
  test "#{factory} builds" do
    assert build(@factory)
  end
<% end %>
end
<%= if @data_case do %>
defp table?(%module{}), do: function_exported?(module, :__schema__, 1) and module.__schema__(:source) != nil
defp table?(_record), do: false
<% end %>
