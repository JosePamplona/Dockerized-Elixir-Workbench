# .env
# Variables used to configure the application secrets.

# Phoenix application configuration
# MIX_ENV="dev"
PHX_HOST="localhost"
PORT="<%= @port %>"
<%= if @ecto do %>DATABASE_URL="<%= @database_url %>"
<% end %># Generate with: mix phx.gen.secret
SECRET_KEY_BASE="<%= @secret_key_base %>"
<%= if @ecto do %># ECTO_IPV6="false"
# POOL_SIZE="10"
<% end %>
<%!-- Optional assigns: workbench.setup2 renders this template for a
vanilla project and passes none of the feature flags. --%>
<%= if assigns[:auth0] do %>
# Auth0 API credentials (Single Page Application)
# Login client attributes (Documentation token request)
AUTH0_DOMAIN="dev-tenant.us.auth0.com"
AUTH0_CLIENT_ID="..."
# JWKS attributes (Backend token validation)
AUTH0_AUDIENCE="https://dev-tenant.us.auth0.com/api/v2/"
AUTH0_ISSUER="https://dev-tenant.us.auth0.com/"

<% end %>
<%= if assigns[:openai] do %>
# AI Assistant credentials
AI_ASSISTANT_API_URL="https://api.openai.com/v1"
AI_ASSISTANT_API_KEY="sk-proj-..."

<% end %>
<%= if assigns[:stripe] do %>
# Stripe API credentials
STRIPE_SECRET="sk_test_..."

<% end %>
